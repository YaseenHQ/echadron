{
  "name": "@moonshot-ai/acp-server",
  "version": "0.0.1",
  "private": true,
  "description": "Experimental ACP v2 server for Echadron, backed by the existing SDK harness",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
